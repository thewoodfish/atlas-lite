# Portaldot WebSocket endpoint
PORTALDOT_WS=wss://mainnet.portaldot.io

# 12-word mnemonic of the demo hot wallet
# WARNING: hackathon demo only — production uses client-side wallet signing
SIGNER_MNEMONIC=your twelve word mnemonic phrase here for the hot wallet

# Deployed IntentLog contract address (ss58 format)
CONTRACT_ADDRESS=5Xxxx...

# OpenAI API key (GPT-4o)
OPENAI_API_KEY=sk-...

# Frontend URL (set in production deployment)
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app
